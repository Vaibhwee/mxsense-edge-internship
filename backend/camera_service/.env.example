# ── Mxsense Camera Service – environment variables ─────────────────────────
# Copy to .env and fill in your real values before starting the service.
# NEVER commit the filled-in .env file to version control.

# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL / RDS) ───────────────────────────────────────────────
DB_HOST=mxsense-db.cfwsawyco4p4.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=mxsense_db
DB_USER=mxsense_admin
DB_PASSWORD=your_rds_password_here
DB_SSLMODE=require

# ── AWS credentials ───────────────────────────────────────────────────────────
# Leave blank to rely on IAM role / instance profile (recommended in production).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=mxsense-images
S3_PRESIGNED_URL_EXPIRY=3600        # seconds

# ── ESP32 ─────────────────────────────────────────────────────────────────────
ESP32_CAPTURE_TIMEOUT=10            # seconds
ESP32_CAPTURE_PATH=/capture

# ── Background capture scheduler ─────────────────────────────────────────────
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30

# ── DB startup behavior ───────────────────────────────────────────────────────
# If true, the service will attempt to create tables on startup (useful for local dev).
DB_CREATE_TABLES_ON_STARTUP=false
